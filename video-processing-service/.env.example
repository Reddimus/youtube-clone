# Copy to .env for local runs. In Cloud Run these are set with
# `gcloud run deploy --set-env-vars=...` instead.

# Port the HTTP server binds. Must be an integer 1-65535.
PORT=3000

# Bucket that receives raw uploads via signed POST policies.
RAW_VIDEO_BUCKET=redd-raw-videos

# Bucket that receives the transcoded rendition ladder.
PROCESSED_VIDEO_BUCKET=redd-processed-videos

# Credentials come from Application Default Credentials. Locally that means
# `gcloud auth application-default login`; on Cloud Run it is the attached
# service account and nothing needs to be set here.
# GOOGLE_APPLICATION_CREDENTIALS=
