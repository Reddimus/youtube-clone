{
    "compilerOptions": {
      "target": "es2022",
      "module": "Node16",
      "moduleResolution": "Node16",
      "rootDir": "src",
      "outDir": "dist",
      "strict": true,
      "skipLibCheck": true,
      "esModuleInterop": true},
    "include": ["src/**/*.ts"],
    "exclude": ["node_modules", "src/**/*.test.ts"]
  }
