# Copy to .env.local and fill in. Every value here is PUBLIC by design —
# Firebase web configuration is meant to be shipped to browsers, and access is
# controlled by security rules, not by hiding these strings.
#
# NEVER put a service-account key in a NEXT_PUBLIC_ variable.
#
# Leave this file uncopied to run in demo mode: with no project configured the
# app serves a seeded feed and the sample clips in public/samples, so it works
# with no cloud account at all.

# Required once you connect a real project (get them from
# `firebase apps:sdkconfig WEB --project <project-id>`).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional.
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Bucket holding processed renditions. Defaults to redd-processed-videos.
NEXT_PUBLIC_PROCESSED_VIDEO_BUCKET=

# Base URL of the deployed Callable functions. Derived from the project ID as
# https://us-central1-<project>.cloudfunctions.net when unset.
NEXT_PUBLIC_FUNCTIONS_BASE_URL=

# Absolute URL used for canonical links and Open Graph. Defaults to
# http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Force demo mode on or off. When unset, demo mode turns itself on whenever
# NEXT_PUBLIC_FIREBASE_PROJECT_ID is empty.
NEXT_PUBLIC_DEMO_MODE=
