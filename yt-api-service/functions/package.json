{
  "name": "@yt/api-service",
  "version": "1.0.0",
  "private": true,
  "description": "Firebase Functions that issue signed upload policies and serve the public video feed.",
  "license": "ISC",
  "main": "lib/index.js",
  "engines": {
    "node": "24"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node24 --format=cjs --outfile=lib/index.js --sourcemap --external:firebase-admin --external:firebase-functions --external:@google-cloud/storage",
    "build:watch": "npm run build -- --watch",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "npm run type-check && npm run lint && npm run test && npm run build",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.22.0",
    "firebase-admin": "^14.2.0",
    "firebase-functions": "^7.3.2"
  },
  "devDependencies": {
    "@yt/contract": "*",
    "esbuild": "^0.28.1"
  }
}
